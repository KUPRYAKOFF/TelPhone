<Window x:Class="TelPhone.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TelPhone" Width="490" Height="685" MinWidth="410" MinHeight="585"
        WindowStartupLocation="CenterScreen" Background="#F4F8F7"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" Language="ru-RU"
        Loaded="OnLoaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="TelPhone" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Connection}" Margin="0,5,0,7"
                       TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                       AutomationProperties.LiveSetting="Polite"/>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Выбрать ADB" Margin="8,0,0,0" Command="{Binding ChooseAdb}"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="Label" VerticalContentAlignment="Center"
                          AutomationProperties.Name="Подключённый телефон"/>
            </DockPanel>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}">
            <TabItem x:Name="PhoneTab" Header="Телефон">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Номер телефона" Margin="0,0,0,5" Foreground="{StaticResource Muted}"/>
                        <TextBox x:Name="NumberInput" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Номер телефона" MaxLength="80" FontSize="27"
                                 Padding="8,4" VerticalContentAlignment="Center" MinHeight="49">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding Call}"/>
                                <KeyBinding Key="Escape" Command="{Binding Clear}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <UniformGrid Columns="3" Margin="-3,10,-3,3">
                            <Button Content="1" Command="{Binding Append}" CommandParameter="1" Style="{StaticResource Keypad}"/>
                            <Button Content="2" Command="{Binding Append}" CommandParameter="2" Style="{StaticResource Keypad}"/>
                            <Button Content="3" Command="{Binding Append}" CommandParameter="3" Style="{StaticResource Keypad}"/>
                            <Button Content="4" Command="{Binding Append}" CommandParameter="4" Style="{StaticResource Keypad}"/>
                            <Button Content="5" Command="{Binding Append}" CommandParameter="5" Style="{StaticResource Keypad}"/>
                            <Button Content="6" Command="{Binding Append}" CommandParameter="6" Style="{StaticResource Keypad}"/>
                            <Button Content="7" Command="{Binding Append}" CommandParameter="7" Style="{StaticResource Keypad}"/>
                            <Button Content="8" Command="{Binding Append}" CommandParameter="8" Style="{StaticResource Keypad}"/>
                            <Button Content="9" Command="{Binding Append}" CommandParameter="9" Style="{StaticResource Keypad}"/>
                            <Button Content="+" Command="{Binding Append}" CommandParameter="+" Style="{StaticResource Keypad}"/>
                            <Button Content="0" Command="{Binding Append}" CommandParameter="0" Style="{StaticResource Keypad}"/>
                            <Button Content="⌫" Command="{Binding Backspace}" Style="{StaticResource Keypad}"
                                    AutomationProperties.Name="Удалить последний символ"/>
                        </UniformGrid>
                        <Button Content="Очистить номер" HorizontalAlignment="Right" Command="{Binding Clear}"/>
                        <UniformGrid Columns="2" Margin="-3,10,-3,0">
                            <Button Content="Позвонить" Command="{Binding Call}" Style="{StaticResource Primary}" Margin="3,0"/>
                            <Button Content="Завершить звонок" Command="{Binding HangUp}" Style="{StaticResource EndCall}" Margin="3,0"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Контакты">
                <DockPanel Margin="12">
                    <Button DockPanel.Dock="Top" Content="Импорт CSV или JSON" HorizontalAlignment="Left"
                            Command="{Binding Import}" Style="{StaticResource Primary}" Margin="0,0,0,9"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                        <Label Content="Группа" Target="{Binding ElementName=GroupFilter}" Padding="0,4,8,4"/>
                        <ComboBox x:Name="GroupFilter" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                                  DisplayMemberPath="Label" MinHeight="30" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                        <Button Content="Сменить группу" Command="{Binding ChangeGroup}" Margin="0,0,8,0"
                                CommandParameter="{Binding SelectedItem, ElementName=ContactList}"/>
                        <Button Content="Набрать номер" Click="ShowPhoneTab" Command="{Binding UseContact}"
                                CommandParameter="{Binding SelectedItem, ElementName=ContactList}"/>
                    </StackPanel>
                    <ListView x:Name="ContactList" ItemsSource="{Binding Contacts}"
                              AutomationProperties.Name="Контакты">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="112"/>
                                <GridViewColumn Header="Номер" DisplayMemberBinding="{Binding Phone}" Width="133"/>
                                <GridViewColumn Header="Группа" DisplayMemberBinding="{Binding GroupLabel}" Width="130"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem Header="История">
                <DockPanel Margin="12">
                    <Button DockPanel.Dock="Bottom" Content="Набрать выбранный номер" HorizontalAlignment="Right"
                            Click="ShowPhoneTab" Command="{Binding UseHistory}" CommandParameter="{Binding SelectedItem, ElementName=HistoryList}"
                            Margin="0,9,0,0"/>
                    <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" AutomationProperties.Name="История вызовов"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5" ToolTip="{Binding DeviceSerial}">
                                    <TextBlock Text="{Binding Phone}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ContactName}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ContactName}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusLabel}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LocalTime, StringFormat=g}" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="{Binding Feedback}" Margin="0,10,0,0" MinHeight="22"
                   TextWrapping="Wrap" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>
