<Window x:Class="TelPhone.Views.ContactGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="370" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#F4F8F7"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" Language="ru-RU">
    <StackPanel Margin="20" FocusManager.FocusedElement="{Binding ElementName=GroupName}">
        <Label Content="Группа" Target="{Binding ElementName=GroupName}" Padding="0,0,0,6"/>
        <ComboBox x:Name="GroupName" IsEditable="True" IsTextSearchEnabled="False"
                  MinHeight="34" VerticalContentAlignment="Center"/>
        <TextBlock Text="Выберите существующую группу, введите новую или оставьте поле пустым."
                   TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,12"/>
        <CheckBox x:Name="UpdateExisting" IsChecked="True" Margin="0,0,0,12">
            <CheckBox.Style>
                <Style TargetType="CheckBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=GroupName}" Value="">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </CheckBox.Style>
            <TextBlock Text="Применить выбранную группу и к уже сохранённым номерам из файла"
                       TextWrapping="Wrap" MaxWidth="290"/>
        </CheckBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="Confirm" IsDefault="True" Style="{StaticResource Primary}" Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
